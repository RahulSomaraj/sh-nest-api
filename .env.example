# =============================================================================
# Server
# =============================================================================
PORT=3008
NODE_ENV=development
# Route prefixes, applied per surface by RouterModule (there is no global prefix).
# admin/v2 = sh-account + extranet, api = sh-website.
API_GLOBAL_PREFIX=admin/v2
API_CUSTOMER_PREFIX=api
# CORS allowlist, comma-separated. REQUIRED in production — the app refuses to boot
# without it, because reflecting any origin together with credentials is unsafe.
CORS_ORIGINS=

# =============================================================================
# Mongo (shared with the legacy Express backend — same collections)
# =============================================================================
MONGO_URL=mongodb://localhost:27017/development
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_REPLICASET=

# =============================================================================
# Auth
# =============================================================================
# Must match legacy API_SECRET so existing tokens stay valid during cutover.
# REQUIRED — the app throws at boot if unset (no fallback secret, ever).
API_SECRET=secret
# Lifetime for newly issued ADMIN tokens. Customer (/api) tokens are issued without
# an expiry, matching legacy — sh-website sessions must not break at cutover.
JWT_EXPIRES_IN=7d

# =============================================================================
# URLs
# =============================================================================
# config.api_url — used to build absolute asset paths and payment return URLs.
API_URL=
APP_URL=https://account.stayhopper.com/
EXTRANET_URL=https://extranet.stayhopper.com/
WEBSITE_URL=https://www.stayhopper.com/
PAYMENT_WEBSITE_URL=https://stayhopper.com/

# =============================================================================
# SendGrid
# =============================================================================
SENDGRID_API_KEY=
WEBSITE_ADMIN_FROM_EMAIL=noreply@stayhopper.com
WEBSITE_ADMIN_FROM_NAME=Stayhopper
WEBSITE_ADMIN_BCC_EMAIL=
WEBSITE_ADMIN_EMAIL=info@stayhopper.com
WEBSITE_CONTACTUS_EMAIL=support@stayhopper.com
WEBSITE_CANCELLATION_EMAIL=support@stayhopper.com
INVOICE_EMAIL=accounts@stayhopper.com
UNPAID_EMAIL=unpaid@stayhopper.com
# HTML template dirs — point at the legacy sh-api repo or copy the files in.
# admin/v2 needs: <publicDir>/reset_password.html, <emailsDir>/welcome.html,
#   <emailsDir>/activate-hotel-admin.html, <publicDir>/booking_confirmation.html,
#   <publicDir>/order_hotel_captured.html, <publicDir>/booking_cancelled.html,
#   <publicDir>/order_cancelled_hotel.html
# api/* additionally needs: <publicDir>/user_welcome.html, <publicDir>/user_reset.html,
#   <publicDir>/app-message.html, <publicDir>/booking_hold.html,
#   <publicDir>/order_hotel_booked.html, <publicDir>/paymentcancelled.html,
#   <publicDir>/resend-confirmation-mail.html
# jobs additionally need: <publicDir>/slotblockcompleted.html,
#   <publicDir>/invoice-emails/invoices-combined-admin.html,
#   <publicDir>/invoice-emails/invoice-property.html
EMAILS_DIR=emails
PUBLIC_DIR=public

# =============================================================================
# Payments
# =============================================================================
# Payment container (hosted payment links, capture/return/vcc). REQUIRED for bookings.
PAYMENT_CONTAINER_URL=
TELR_API=
TELR_STORE_ID=
# Shared secret for HMAC-verifying capture/return webhooks. When unset the guard logs
# a warning and allows the request (non-breaking rollout).
PAYMENT_WEBHOOK_SECRET=

# =============================================================================
# Pricing / booking constants (legacy config/*.json)
# Changing any of these changes what guests are charged.
# =============================================================================
COMMISSION_HOURLY=15
COMMISSION_MONTHLY=15
BOOKING_CHARGE=10
MAMOPAY_CHARGES=6
DAILY_HOURS=22
REBOOKING_AMT=10
VAT=5
MAX_DISTANCE=4000
DATE_BLOCK_NUMBER=30
MIN_NUMBER_OF_BOOKING_HOURS=4
TEST_PROPERTY=5c34612e63b3ad0b1d4602fd
# Per-country, per-booking-type platform fee. Defaults to the legacy UAE + India table;
# override wholesale with the same JSON shape if it changes.
BOOKING_FEE_JSON=

# Country/timezone defaults used by the /api countrySelection middleware.
COUNTRY_ID_UAE=5b87b5e26ebfc73aed2589f7
DEFAULT_TIMEZONE=Asia/Dubai

# Result-set sizes for the home-page property lists and search.
PAGE_SIZE_POPULAR=10
PAGE_SIZE_CHEAPEST=10
PAGE_SIZE_SEARCH=10

# =============================================================================
# Third-party (customer surface)
# =============================================================================
# ⚠ The legacy key was committed in source (controllers/api/v2/main.js:18) — set a NEW
# key here and ROTATE the old one. Empty => GET /api/main/redirect/:params errors.
GOOGLE_MAPS_API_KEY=

MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_ADMIN_LIST_ID=
MAILCHIMP_ANDROID_ID=
MAILCHIMP_IOS_ID=

# =============================================================================
# Push notifications (background jobs)
# =============================================================================
# Legacy used the FCM *legacy* HTTP API, which Google has decommissioned. Ported jobs
# use FCM HTTP v1 with a service account. Pushes are a no-op unless ENABLE_PUSH=true
# AND credentials resolve.
ENABLE_PUSH=false
FCM_SERVICE_ACCOUNT_PATH=
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
# Deep-link base used in the hotel booking email.
ACCOUNT_URL=

# =============================================================================
# Background jobs
# =============================================================================
# ⚠ Set to true on EXACTLY ONE PM2 instance. The jobs delete booking logs, move bookings
# between collections and mutate slot state — two instances double-fire all of them.
# ⚠ Before enabling, remove require("./cron") and require("./cron-invoices") from the
# legacy sh-api index.js, or nest and legacy will race each other.
ENABLE_CRON=false
