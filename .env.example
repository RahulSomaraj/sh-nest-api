# Server
PORT=3008
NODE_ENV=development
# Global route prefix consumed by the sh-account frontend (config.apiUrl = .../admin/v2)
API_GLOBAL_PREFIX=admin/v2

# Mongo (mirrors the legacy Express backend)
MONGO_URL=mongodb://localhost:27017/development
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_REPLICASET=

# Auth — must match legacy API_SECRET so existing tokens stay valid during cutover
API_SECRET=secret

# SendGrid (reset-password / welcome / activation emails)
SENDGRID_API_KEY=
WEBSITE_ADMIN_FROM_EMAIL=noreply@stayhopper.com
WEBSITE_ADMIN_FROM_NAME=Stayhopper
WEBSITE_ADMIN_BCC_EMAIL=
APP_URL=https://account.stayhopper.com/
EXTRANET_URL=https://extranet.stayhopper.com/
# HTML template dirs — point at the legacy sh-api repo or copy the files in.
# Needed: <publicDir>/reset_password.html, <emailsDir>/welcome.html, <emailsDir>/activate-hotel-admin.html
EMAILS_DIR=emails
PUBLIC_DIR=public
